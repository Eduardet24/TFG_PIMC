set xlabel rotate by 0
set ylabel rotate by 90
set title  rotate by 0

set xlabel font 'Times New Roman Bold, 14' rotate by 0 "r"
set ylabel font 'Times New Roman Bold, 14' rotate by 90 "n(r)"
set title font 'Times New Roman Bold, 14' rotate by 0


# 1D quantum harmonic oscillator at temperature T
# Units: hbar = k_B = 1

m     = 1.
omega = 1.
T     = 10.

alpha = m*omega*tanh(omega/(2.*T))

x2 = 1./(2.*m*omega*tanh(omega/(2.*T)))

print sprintf("<x^2> = %.12g", x2)

nExact(x) = sqrt(alpha/pi)*exp(-alpha*x**2)

set title "radial distribution function"
set xlabel "x"
set ylabel "n(x)"
set grid
set xrange [0:3.0/sqrt(alpha)]


!AnalOBDM outrdz.dat rdz.dat
pause -1

plot [x=:][0:] "outrdz.dat" u 1:2 w p t "PIMC", nExact(x) with lines lw 2 title "exact"
pause -1

plot [x=:][0:] "rdz.dat" u 1:2:3 w e t "PIMC", nExact(x) with lines lw 2 title "exact"
pause -1

plot [r=:][0:] "outrdz.dat"
pause -1

