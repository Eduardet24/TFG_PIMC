"""Plot PIMC potential-energy convergence from archived oute.dat files."""

import re
from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np
from scipy.stats import linregress


PROJECT_DIR = Path(__file__).resolve().parent
RESULTS_DIR = PROJECT_DIR / 'Resultados' / '1DArmonico'
OUTPUT_NAME = 'convergencia_energia_potencialvsBeads.png'
CAMPAIGN_NAME = 'lote_blck1000'


def config_value(config_text, key):
    match = re.search(rf'\b{re.escape(key)}\s*=\s*([0-9.]+)', config_text)
    if match is None:
        raise ValueError(f'No se pudo leer {key} de MC.cfg')
    return float(match.group(1))


def read_pimc_potential(energy_file):
    """Estimate Epot and its error from production-block means in one run."""
    data = np.loadtxt(energy_file, comments='#', ndmin=2)
    if data.shape[1] < 3:
        return None

    run_config = (energy_file.parent / 'MC.cfg').read_text(encoding='utf-8')
    niter = int(config_value(run_config, 'Niter'))
    nmeasure = int(config_value(run_config, 'Nmeasure'))
    if nmeasure <= 0 or niter % nmeasure != 0:
        raise ValueError(f'Niter/Nmeasure no válido en {energy_file.parent / "MC.cfg"}')
    samples_per_block = niter // nmeasure
    values = data[:, 1]
    complete_blocks = values.size // samples_per_block
    if complete_blocks < 2 or values.size % samples_per_block:
        raise ValueError(f'{energy_file} no contiene bloques de producción completos')

    block_means = values[:complete_blocks * samples_per_block].reshape(
        complete_blocks, samples_per_block
    ).mean(axis=1)
    mean = float(np.mean(block_means))
    error = float(np.std(block_means, ddof=1) / np.sqrt(block_means.size))
    return mean, error, complete_blocks


def main():
    config_text = (PROJECT_DIR / 'MC.cfg').read_text(encoding='utf-8')
    acceptance_rate = config_value(config_text, 'acceptance_rate')
    temperature = config_value(config_text, 'T')
    runs = {}

    series_dir = (RESULTS_DIR / f'AR{acceptance_rate:g}' / CAMPAIGN_NAME /
                  f'Temp{temperature:g}')
    for energy_file in series_dir.glob('N*/oute.dat'):
        match = re.fullmatch(r'N(\d+)', energy_file.parent.name)
        if match is None or not (energy_file.parent / '.complete').is_file():
            print(f'Se omite corrida incompleta: {energy_file.parent}')
            continue
        estimate = read_pimc_potential(energy_file)
        if estimate is None:
            print(f'Se omite {energy_file}: solo contiene energía total (formato antiguo).')
            continue
        runs[int(match.group(1))] = estimate

    if not runs:
        raise FileNotFoundError(f'No hay archivos oute.dat compatibles en {series_dir}/N*/')

    n_beads = np.array(sorted(runs), dtype=int)
    inverse_n = 1.0 / n_beads
    energies = np.array([runs[n][0] for n in n_beads])
    errors = np.array([runs[n][1] for n in n_beads])

    figure, axis = plt.subplots(figsize=(8, 6))
    point_label = ('Epot PIMC' if n_beads.size >= 2
                   else 'Epot PIMC (un N; sin ajuste)')
    axis.errorbar(inverse_n, energies, yerr=errors, fmt='o', capsize=4,
                  markersize=7, label=point_label)
    for beads, x_value, energy in zip(n_beads, inverse_n, energies):
        axis.annotate(f'N={beads}', (x_value, energy), xytext=(5, 7),
                      textcoords='offset points')

    if n_beads.size >= 2:
        fit = linregress(inverse_n, energies)
        fit_x = np.linspace(0.0, inverse_n.max() * 1.05, 200)
        fit_y = fit.intercept + fit.slope * fit_x
        energy_exact = 0.25 / np.tanh(1.0 / (2.0 * temperature))
        fit_label = 'Ajuste lineal' if n_beads.size >= 3 else 'Ajuste orientativo (solo 2 N)'
        axis.plot(fit_x, fit_y, 'r--', label=fit_label)
        axis.axhline(energy_exact, color='black', linestyle=':',
                     label=f'Analítico a T={temperature:g}: {energy_exact:.4f}')
        axis.scatter([0.0], [fit.intercept], marker='X', s=100, color='tab:red',
                     label=f'Extrapolación N→∞: {fit.intercept:.4f}')
        print(f'Pendiente dEpot/d(1/N) = {fit.slope:.8f}')
        print(f'Extrapolación Epot(N→∞) = {fit.intercept:.8f}')
        print(f'Referencia analítica Epot(T={temperature:g}) = {energy_exact:.8f}')
        if n_beads.size == 2:
            print('Aviso: con solo dos N y errores solapados, la tendencia no es concluyente.')
    else:
        print('Solo hay una corrida con Epot directa; no se realiza ajuste.')

    axis.set_title(
        f'Convergencia de Epot (AR={acceptance_rate:g}, T={temperature:g})'
    )
    axis.set_xlabel(r'$1/N_{beads}$')
    axis.set_ylabel(r'$E_{pot}$')
    axis.set_xlim(0.0, inverse_n.max() * 1.15)
    axis.grid(True, linestyle=':', alpha=0.7)
    axis.legend()
    figure.tight_layout()
    output_file = series_dir / OUTPUT_NAME
    figure.savefig(output_file, dpi=300, bbox_inches='tight')
    print(f'N_beads incluidos: {n_beads.tolist()}')
    print(f'Bloques completos por corrida: {[runs[n][2] for n in n_beads]}')
    print(f'Figura guardada en {output_file}')
    plt.show()


if __name__ == '__main__':
    main()